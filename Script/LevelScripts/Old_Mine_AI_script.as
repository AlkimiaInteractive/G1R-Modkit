class UWP_OM_CAVETEMPLARS_MINECRAWLER_SPAWN_02 : UWorldPointScript
{
    UFUNCTION()
	void OnBringMandibles()
	{
        for (auto Minecrawler : FCharacterUniqueName(n"MinecrawlerNamed").AllNPCStates)
        {
            if (!Minecrawler.IsDead())
            {
                Minecrawler.RemoveFromWorld();
            }
        }

		SpawnAIAgent(USpawnAIAgentDefinition_Minecrawler::StaticClass(), UDailyRoutine_Minecrawler(1300));
		SpawnAIAgent(USpawnAIAgentDefinition_Minecrawler::StaticClass());
        SpawnAIAgent(USpawnAIAgentDefinition_Minecrawler::StaticClass());
		SpawnAIAgent(USpawnAIAgentDefinition_Minecrawler::StaticClass());
		SpawnAIAgent(USpawnAIAgentDefinition_Minecrawler::StaticClass());
	}
};

