class UWP_EZ_SHIPMENT_SPAWN: UWorldPointScript
{
    UFUNCTION()
    void OnShipmentAttack()
    {
		for (auto Rogue1 : FCharacterUniqueName(n"NC_ORG_Rogue33_882N").AllNPCStates)
        {
            if (IsCharacterInWorld(Rogue1))
            {
                Rogue1.RemoveFromWorld();
            }
        }

		for (auto Rogue2 : FCharacterUniqueName(n"NC_ORG_Rogue34_883N").AllNPCStates)
        {
            if (IsCharacterInWorld(Rogue2))
            {
                Rogue2.RemoveFromWorld();
            }
        }

		for (auto Rogue3 : FCharacterUniqueName(n"NC_ORG_Rogue35_884N").AllNPCStates)
        {
            if (IsCharacterInWorld(Rogue3))
            {
                Rogue3.RemoveFromWorld();
            }
        }

		for (auto Rogue4 : FCharacterUniqueName(n"NC_ORG_Rogue36_885N").AllNPCStates)
        {
            if (IsCharacterInWorld(Rogue4))
            {
                Rogue4.RemoveFromWorld();
            }
        }

        SpawnAIAgent(USpawnAIAgentDefinition_NC_ORG_Rogue33_882N::StaticClass(),UDailyRoutine_NC_ORG_Rogue33_882N_Shipment());
        SpawnAIAgent(USpawnAIAgentDefinition_NC_ORG_Rogue34_883N::StaticClass(),UDailyRoutine_NC_ORG_Rogue34_883N_Shipment());
        SpawnAIAgent(USpawnAIAgentDefinition_NC_ORG_Rogue35_884N::StaticClass(),UDailyRoutine_NC_ORG_Rogue35_884N_Shipment());
        SpawnAIAgent(USpawnAIAgentDefinition_NC_ORG_Rogue36_885N::StaticClass(),UDailyRoutine_NC_ORG_Rogue36_885N_Shipment());
    }
};

